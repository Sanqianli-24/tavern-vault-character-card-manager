{
  "name": "sillytavern-character-library",
  "version": "0.6.0",
  "description": "中文 SillyTavern 角色卡管理器与一键启动器",
  "author": "LongShuo",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:check": "npm run desktop:build && node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "desktop:pack": "npm run desktop:build && electron-builder --win nsis portable",
    "test": "npm run build && node --test tests/character-parser.test.mjs tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "build": {
    "appId": "cn.sillytavern.characterlibrary",
    "productName": "酒馆角色卡库",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sanqianli-24",
        "repo": "tavern-vault-character-card-manager"
      }
    ],
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/character-parser.cjs",
      "desktop-dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "TavernCardLibrary-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "酒馆角色卡库",
      "installerLanguages": [
        "zh_CN"
      ]
    },
    "portable": {
      "artifactName": "TavernCardLibrary-Portable-${version}-${arch}.${ext}"
    }
  },
  "type": "module"
}
